{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/example-hook.sh\" session-start",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
